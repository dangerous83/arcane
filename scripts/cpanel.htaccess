DirectoryIndex index.html
Options -Indexes

# Revalidate page and application files instead of using a heuristic cache age.
# Images retain their normal caching behavior.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|css|js)$">
    Header onsuccess unset Cache-Control
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header onsuccess unset Expires
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    Header always set X-Arcane-Release "browser-consistency-20261025"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bypass any old Approach folder and serve the current shared-layout page.
  RewriteRule ^approach(?:/index\.html)?/?$ approach.html [L]
  # Serve the Gallery from a root file even if the nested folder is absent.
  RewriteRule ^gallery/?$ gallery.html [L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?arcane-rp\.online$ [NC]
  RewriteRule ^ https://www.arcane.ae%{REQUEST_URI} [R=301,L,NE]
  RewriteRule ^(?:api|scripts|templates|content|\.git)(?:/|$) - [F,L]
</IfModule>
